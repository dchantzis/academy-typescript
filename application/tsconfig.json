{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "lessons/**/*.ts",
    "exercises/**/*.ts",
    "mock-interviews/**/*.ts",
    "tests/**/*.ts"
  ]
}
